# Token secreto para autenticar /api/revalidate/matches
# Generá uno con: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# En Vercel: Settings > Environment Variables > REVALIDATE_SECRET
REVALIDATE_SECRET=

# URL pública de la Google Sheet con los partidos (sin gid ni output)
SHEETS_BASE_URL=

# URL base del sitio (pública, se inyecta en el bundle del cliente)
NEXT_PUBLIC_SITE_URL=https://juegamoron.vercel.app
